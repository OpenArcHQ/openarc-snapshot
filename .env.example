# Shared build identity
COMMIT_SHA=local

# API shell. M00 has no live Arc provider call.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Web build identity and same-origin API path.
VITE_COMMIT_SHA=local
VITE_API_BASE_URL=/v1
VITE_ENCRYPTED_WORKSPACE_ENABLED=false
VITE_API_BOUNDARY_ENABLED=false
API_BOUNDARY_ENABLED=false
VITE_ARC_OBSERVATION_ENABLED=false
ARC_OBSERVATION_ENABLED=false
VITE_AGENT_REGISTRY_ENABLED=false
AGENT_REGISTRY_ENABLED=false
VITE_AGENT_JOBS_ENABLED=false
AGENT_JOBS_ENABLED=false
VITE_GATEWAY_EVIDENCE_ENABLED=false
VITE_GENERIC_AGENT_IMPORT_ENABLED=false
VITE_INVESTIGATIONS_ENABLED=false
# Enabling the agent registry or jobs also requires the cumulative flags, configured Redis/proxy/abuse
# boundaries, and SOURCE_MAX_SUBCALLS >= 16. Never put real secrets in this file.
