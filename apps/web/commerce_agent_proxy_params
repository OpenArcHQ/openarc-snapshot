proxy_http_version 1.1;

# Disable the default blanket request-header passthrough: only the explicit
# allowlist below reaches the API. The agent surface is headless and NEVER
# carries a browser Cookie/Origin/Fetch-Metadata marker, so every browser
# credential is rejected in the location block before this include runs and is
# never forwarded here. Request bodies are handled by the caller locations; the
# POST exchange adds its bounded Content-Type/Content-Length/Idempotency-Key
# after this include, the GET status adds none.
proxy_pass_request_headers off;
proxy_set_header Connection "";
proxy_set_header Host $proxy_host;
proxy_set_header Authorization $http_authorization;
proxy_set_header Accept $http_accept;

proxy_hide_header Strict-Transport-Security;

# Verified upstream TLS/SNI/trust is inherited from the enclosing server
# template, which expands API_UPSTREAM_SNI / API_TRUST_BUNDLE at startup.
proxy_ssl_server_name on;
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;

proxy_connect_timeout 3s;
proxy_send_timeout 10s;
proxy_read_timeout 10s;

# No automatic upstream retry, no response caching or spooling to disk.
proxy_next_upstream off;
proxy_request_buffering off;
proxy_buffering off;
proxy_max_temp_file_size 0;
